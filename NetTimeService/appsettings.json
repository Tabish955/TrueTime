{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NtpSettings": {
    "Servers": [
      "custom.time.org",
      "time.google.com"
    ],
    "ServerEntries": [
      {
        "Hostname": "custom.time.org",
        "Enabled": true
      },
      {
        "Hostname": "time.google.com",
        "Enabled": true
      }
    ],
    "PollIntervalMinutes": 5,
    "ThresholdMilliseconds": 100
  }
}